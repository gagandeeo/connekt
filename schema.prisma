datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = -1
}

enum UserRole {
  ADMIN
  NORMAL
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  password   String
  role       UserRole   @default(NORMAL)
  created_at DateTime   @default(now())

  landmarks  Landmark[]
}

model Boundary {
  boundary_id BigInt @id @default(autoincrement())
  name        String
  coords      Json

  landmarks         Landmark[]
  nested_boundaries NestedBoundary[]
  voronoi_cells     VoronoiCell[]
}

model Landmark {
  id          Int      @id @default(autoincrement())
  boundary_id BigInt
  boundary    Boundary @relation(fields: [boundary_id], references: [boundary_id], onDelete: Cascade)
  name        String
  lat         Float
  lon         Float
  is_base     Boolean  @default(false)
  user_id     Int?
  user        User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([boundary_id, is_base])
  @@index([boundary_id, user_id])
}

model NestedBoundary {
  id          Int      @id @default(autoincrement())
  boundary_id BigInt
  boundary    Boundary @relation(fields: [boundary_id], references: [boundary_id], onDelete: Cascade)
  child_name  String
  coords      Json

  @@unique([boundary_id, child_name])
}

model VoronoiCell {
  id          Int      @id @default(autoincrement())
  boundary_id BigInt
  boundary    Boundary @relation(fields: [boundary_id], references: [boundary_id], onDelete: Cascade)
  name        String
  lat         Float
  lon         Float
  polygon     Json

  @@index([boundary_id])
}
